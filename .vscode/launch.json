{
  "version": "0.2.0",
  "configurations": [
    {
      // F5: debug build, stop any running WinLaunch, start under the MSVC debugger.
      "name": "Debug winlaunch",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/target/debug/winlaunch.exe",
      "args": [],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "preLaunchTask": "build + quit running instance"
    }
  ]
}
